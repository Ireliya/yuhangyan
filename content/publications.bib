@misc{yan2026disastersage,
  selected = {true},
  title = {DisasterSAGE: Towards Evidence-to-Action Foundation Models for Disaster Response from Remote Sensing},
  author = {Yuhang Yan and X. Tan and J. Yao and L. Mou and B. Yang and Q. Li*},
  year = {2026},
  month = {August},
  preview = {disaster1_00.png},
  keywords = {Disaster Response, Remote Sensing, Vision-Language Models, Evidence-to-Action Learning, Reinforcement Learning},
  description = {An Evidence-to-Action framework for disaster reasoning that turns grounded remote-sensing evidence into verifiable, rule-constrained response decisions.},
  description_zh = {一个面向灾害响应的 Evidence-to-Action 框架，将遥感影像中的可定位证据转化为可验证、受规则约束的响应决策。},
  abstract = {Vision-language models have shown promising capabilities in understanding remote sensing imagery, but disaster response requires more than visual recognition or question answering. DisasterSAGE introduces an Evidence-to-Action framework for disaster reasoning: DisasterSAGE-Agent constructs verified E2A traces from mask-complete evidence, professional knowledge, and deterministic execution; DisasterSAGEBench provides 75,843 image-conditioned tasks from 42 real-world events and 13 terrestrial and marine disaster types; and Disaster-Codex aligns a 7B vision-code model through E2A supervised fine-tuning, Grounding reinforcement learning, and Action reinforcement learning.},
  abstract_zh = {视觉语言模型在遥感影像理解方面展现出潜力，但灾害响应需要的不只是视觉识别或问答。DisasterSAGE 提出一个面向灾害推理的 Evidence-to-Action 框架：DisasterSAGE-Agent 基于完整掩膜证据、专业知识和确定性执行构建可验证的 E2A 轨迹；DisasterSAGEBench 从 42 个真实灾害事件和 13 类陆地与海洋灾害中构建 75,843 个图像条件任务；Disaster-Codex 则通过 E2A 监督微调、Grounding 强化学习和 Action 强化学习对 7B 视觉代码模型进行对齐。},
  pdf = {/papers/DisasterSAGE.pdf},
}

